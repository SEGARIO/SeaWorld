  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ef99e79683bc6a74ebbe44f3a005ae0c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  entries:
  - _text: ' '
    _textColor: {r: 0, g: 0, b: 0, a: 0}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 1
  - _text: "Tiens? On a d\xFB atteindre les ruines..."
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "On a march\xE9 si longtemps que \xE7a?"
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  entriesEnglish:
  - _text: ' '
    _textColor: {r: 0, g: 0, b: 0, a: 0}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 1
  - _text: Huh? We're already in the ruins?
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Have we been walking for that long?
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  _text: {fileID: 1358616519}
  _index: -1
  _imobilisePlayer: 0
  _controller: {fileID: 0}
  _canActivateSomething: 0
