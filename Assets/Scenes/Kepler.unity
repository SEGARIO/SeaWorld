      propertyPath: '_otherDialoguesEnglish.Array.data[1]'
      value: This place is amazing!
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_otherDialoguesEnglish.Array.data[2]'
      value: It was built by an ancient civilization that lived here before the humans!
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_otherDialoguesEnglish.Array.data[3]'
      value: I want to know what happened to them...
