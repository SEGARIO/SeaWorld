    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: _textColors.Array.size
      value: 54
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[1]'
      value: TEMOIGNAGES
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[2]'
      value: 12 Juin 783, Kepler B.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[3]'
      value: "Trois voyageurs se perdent dans une temp\xEAte de neige."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[4]'
      value: "Ils observent au loin une forme humano\xEFde."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[5]'
      value: Ils se rapprochent, pensant trouver de l'aide.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[6]'
      value: "Mais ce n'\xE9tait pas un homme."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[7]'
      value: "Il ressemblait plut\xF4t \xE0 un \xEAtre hybride."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[8]'
      value: "Une sorte de m\xE9lange entre un homme et un ours."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[9]'
      value: "Il \xE9tait bip\xE8de et mesurait deux fois la taille d'un homme."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[10]'
      value: "Anton s'est noy\xE9 dans une des rivi\xE8res sousterraines des ruines"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[11]'
      value: "malgr\xE9 les m\xE9canismes permettant de r\xE9duire le niveau de l'eau"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[12]'
      value: "Nous avons trouv\xE9 une salle secr\xE8te. "
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[13]'
      value: "On y a trouv\xE9 un crystal en forme d'\xE9toile."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[14]'
      value: "Nous n'avons pas os\xE9 la toucher, il se passe tellement de choses
        \xE9tranges ici."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[15]'
      value: 'Jour 3:'
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[16]'
      value: "Nous avons \xE9t\xE9 attaqu\xE9 par des scarab\xE9es g\xE9ants."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[17]'
      value: "C'est la premi\xE8re fois que j'en vois d'aussi grands."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[18]'
      value: "Nous avons r\xE9ussi \xE0 les semer quand ils se sont heurt\xE9s entre
        eux."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[19]'
      value: Nous avons pu nous reposer pour la nuit.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[20]'
      value: 'Jour 4:'
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[21]'
      value: "Nous avons trouv\xE9 la fresque dont parlait le vieil homme!"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[22]'
      value: "C'\xE9tait dans une salle secr\xE8te, o\xF9 se trouvait un autre crystal
        en forme d'\xE9toile."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[23]'
      value: "La fresque a l'air de repr\xE9senter une esp\xE8ce alien inconnue."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[24]'
      value: "S\xFBrement l'esp\xE8ce \xE0 l'origine de ces ruines."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[25]'
      value: 'Jour 5:'
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[26]'
      value: "D'\xE9tranges vases nous ont courru apr\xE8s aujourd'hui."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[27]'
      value: "J'imagine qu'ils ont eux aussi \xE9t\xE9 cr\xE9\xE9s par l'esp\xE8ce
        inconnue."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[28]'
      value: 'Jour 6:'
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[29]'
      value: En essayant de sortir des grottes, nous avons fini dans cette salle.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[30]'
      value: Un autre crystal s'y trouve. Cette fois, Russell a vuolu y toucher.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[31]'
      value: "Rien ne s'est pass\xE9."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[32]'
      value: 'Jour 7:'
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[33]'
      value: "D\xE9j\xE0 une semaine que nous sommes dans ces ruines."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[34]'
      value: "Nous avons \xE9t\xE9 surpris par une b\xEAte g\xE9ante."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[35]'
      value: "Un ver g\xE9ant? Un serpent? Je n'en sais rien."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[36]'
      value: "Heureusement, la b\xEAte ne nous a pas vu."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[37]'
      value: "Cependant, nous sommes retourn\xE9s \xE0 l'int\xE9rieur de la salle."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[38]'
      value: 'Jour 10:'
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[39]'
      value: "Nous sommes toujours dans la salle secr\xE8te."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[40]'
      value: "La b\xEAte nous emp\xEAche de sortir."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[41]'
      value: "Si \xE7a continue, nous allons mourir de faim."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[42]'
      value: 'Jour 18:'
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[43]'
      value: "Ca ne peut plus se passer comme \xE7a."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[44]'
      value: "La b\xEAte semble avoir un point faible au bout de sa queue."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[45]'
      value: Nous allons l'attaquer.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[46]'
      value: 'Jour 19:'
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[47]'
      value: "Ca a fonctionn\xE9!"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[48]'
      value: "La b\xEAte s'est enfuie quand on a touch\xE9 le bout de sa queue!"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[49]'
      value: Nous allons pouvoir repartir en direction de Kairos.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[50]'
      value: "C'est la derni\xE8re plan\xE8te sur notre liste."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[51]'
      value: "Je laisse ce carnet ici, si \xE7a peut aider un \xE9ventuel lecteur
        dans le futur."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[52]'
      value: "Bon courage \xE0 vous!"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[53]'
      value: "Et c'est sign\xE9 \"Taylor\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: _otherDialogues.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: _otherTextColors.Array.size
      value: 11
      objectReference: {fileID: 0}
