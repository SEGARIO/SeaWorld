      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_audios.Array.data[10]'
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: _textColors.Array.size
      value: 21
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[1]'
      value: "J'ai essay\xE9 d'explorer les ruines..."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[2]'
      value: "Mais il y avait trop de monstres l\xE0-dedans."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[3]'
      value: Je n'y retournerai qu'une fois qu'ils auront tous disparu.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[4]'
      value: "Bon ok, peut-\xEAtre pas tous..."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[5]'
      value: "Faisons un march\xE9."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[6]'
      value: "Si tu arrives \xE0 \xE9liminer 30 enemis..."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[7]'
      value: "Je te donnerai une belle r\xE9compense."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[8]'
      value: "Que dis-tu de \xE7a?"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[9]'
      value: "Alors \xE7a, c'est g\xE9nial! J'y vais tout de suite!"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[10]'
      value: "Ah non, \xE7a va pas \xEAtre possible."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[11]'
      value: "On est dimanche. C'est ferm\xE9."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[12]'
      value: Oh, non, dommage...
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[13]'
      value: "Si tu comptes quitter Igara d\xE8s \xE0 pr\xE9sent, "
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[14]'
      value: le plus simple c'est de trouver quelqu'un avec un vaisseau
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[15]'
      value: qui acceptera de t'emmener.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[16]'
      value: "O\xF9 est ce que je peux trouver quelqu'un comme \xE7a?"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[17]'
      value: J'ai vu un pilote partir dans les grottes.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[18]'
      value: "Si tu lui demandes peut-\xEAtre qu'il acceptera."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[19]'
      value: "Quoique, il avait l'air plut\xF4t chafouin..."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[20]'
      value: Merci, l'ami!
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: _otherDialogues.Array.size
      value: 2
      objectReference: {fileID: 0}
