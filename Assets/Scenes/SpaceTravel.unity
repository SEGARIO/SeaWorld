--- !u!114 &1134400299
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1134400298}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ef99e79683bc6a74ebbe44f3a005ae0c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  entries:
  - _text: "Je dois r\xE9parer le turbo, prends les commandes le temps que je finisse. "
    _textColor: {r: 0.4528302, g: 0.16692564, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: Quoi?! Mais j'ai pas mon permis de piloter, moi!
    _textColor: {r: 1, g: 0.36862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Ne t'inqui\xE8te pas! Garde le cap et \xE7a devrait aller"
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: Je t'ai mis la vitesse la plus lente.
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Si besoin, tu peux te d\xE9placer avec le joystick gauche."
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: S'il y a des obstacles, tu peux les viser avec le joystick droit, et tirer
      avec la gachette.
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: "Pratique, ces commandes, on dirait une manette de jeu vid\xE9o. "
    _textColor: {r: 1, g: 0.36862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: ' '
    _textColor: {r: 1, g: 1, b: 1, a: 0}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Ca y est, on est enfin sortis des grottes!
    _textColor: {r: 1, g: 0.36862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Tant mieux. Mais reste vigilant, il y a toujours des obstacles \xE0 \xE9viter. "
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: "Euh\u2026 Je pr\xE9fererai quand m\xEAme que ce soit toi qui pilotes."
    _textColor: {r: 1, g: 0.36862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: Tu en as encore pour longtemps?
    _textColor: {r: 1, g: 0.36862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: 'Un peu de patience, il me faut trois minutes en tout. '
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Mais si je ne le r\xE9pare pas maintenant, on ne pourra jamais partir
      de cette plan\xE8te."
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 5
  - _text: "Sans le turbo, on mettrait des semaines \xE0 atteindre une autre plan\xE8te."
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: "Je commence \xE0 me dire que j'aurais mieux fait de rester dans le train
      spatial\u2026"
    _textColor: {r: 1, g: 0.36862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Eh! C'est quoi cette mentalit\xE9, d'un coup?"
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: Tu veux marcher sur le Soleil, oui ou non?
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Euh\u2026 oui..."
    _textColor: {r: 1, g: 0.36862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Gr\xE2ce \xE0 toi, j'ai pu r\xE9cup\xE9rer mon vaisseau."
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Je t'ai vu battre le L\xE9vierthan alors que tout le monde disait que
      c'\xE9tait impossible."
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: "Alors si tu es certain de pouvoir \xEAtre la premi\xE8re personne \xE0
      poser le pied sur le Soleil."
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 5
  - _text: 'Je pense que tu peux y arriver.    '
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: ...
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: Alors reprends un peu confiance en toi!
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Si tu n'arrives m\xEAme pas \xE0 piloter un vaisseau sur quelques m\xE8tres"
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: "Alors autant qu'on arr\xEAte tout maintenant et que tu retournes dans
      le train."
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 5
  - _text: ' '
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "C'\xE9tait le train?"
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Tu veux toujours monter dedans? C'est l'occasion.
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Non, c'est bon, tu m'as remotiv\xE9!"
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Si je garde mon objectif en t\xEAte, je peux tout faire!"
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Moi, Cosmo, je serais la premi\xE8re personne \xE0 marcher sur le Soleil!"
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 5
  - _text: "Je sais toujours pas comment tu comptes t'y prendre, mais je pr\xE9f\xE8re
      cet \xE9tat d'esprit l\xE0!"
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 5
  - _text: "Ne t'inqui\xE8te pas, j'ai un plan!"
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Mais tu le verras en temps voulu! Vu que tu seras l\xE0 pendant que je
      marcherai sur le Soleil!"
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 5
  - _text: "Ah euh\u2026 "
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Je crois qu'on s'est mal compris\u2026"
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Comment \xE7a?"
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 1
  - _text: "Je n'ai jamais dit que je t'accompagnerai jusqu'au Soleil\u2026"
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Moi, ma destination c'est Gorgon, la plan\xE8te de lave."
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: "J'ai seulement accept\xE9 de t'aider \xE0 partir d'Igara et te rapprocher
      le plus possible pour que \xE7a t'arrange, c'est tout. "
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 5
  - _text: "Oh, euh\u2026 C'est un peu g\xE9nant du coup\u2026"
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: ' '
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: Bon, et ben c'est pas grave!
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Ca me rapproche d\xE9j\xE0 pas mal de mon objectif, merci."
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: "A partir de Gorgon, je me d\xE9brouillerai."
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Dans tous les cas, tu me verras marcher sur le Soleil, j'en suis s\xFBr!"
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: "Si tu n'est pas avec moi \xE0 ce moment l\xE0, tu me verras s\xFBrement
      \xE0 la t\xE9l\xE9!"
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: ' '
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Tiens, le train! Il n'\xE9tait pas devant nous?"
    _textColor: {r: 0.4509804, g: 0.16862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: ' '
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Euh... Dis, tu pourrais te d\xE9pecher avec le turbo?"
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Parce que l\xE0, on fonce droit dans le mur..."
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: Encore une petite modification et...
    _textColor: {r: 0.3962264, g: 0.14761376, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: C'EST PARTI!!!
    _textColor: {r: 0.3962264, g: 0.14761376, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: Woohooo!!!
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Accroche-toi, on va traverser l'atmosph\xE8re!"
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: ' '
    _textColor: {r: 1, g: 0.37391305, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 5
  - _text: Ca y est! On est dans l'espace!
    _textColor: {r: 1, g: 0.3703704, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: Attention! Regarde devant toi!
    _textColor: {r: 0.26415092, g: 0.097373284, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: ' '
    _textColor: {r: 0.26415092, g: 0.097373284, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 6
  - _text: "Heureusement que tu m'as pr\xE9venu!"
    _textColor: {r: 1, g: 0.37313432, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Reste concentr\xE9!"
    _textColor: {r: 0.3679245, g: 0.13706993, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: ' '
    _textColor: {r: 0.3679245, g: 0.13706993, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: "Wow! C'\xE9tait la Spatioroute?"
    _textColor: {r: 1, g: 0.37234044, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "C'est la premi\xE8re fois que je la vois en vrai..."
    _textColor: {r: 1, g: 0.37234044, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: ' '
    _textColor: {r: 1, g: 0.37234044, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: Zut! On a presque plus d'essence...
    _textColor: {r: 0.31132078, g: 0.11598226, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "A ce rythme l\xE0, on arrivera pas jusqu'\xE0 la prochaine plan\xE8te."
    _textColor: {r: 0.3679245, g: 0.13706993, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: "On va devoir s'arr\xEAter sur une des lunes de Kepler B pour faire le
      plein."
    _textColor: {r: 0.3301887, g: 0.12301148, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 5
  - _text: Regarde la carte spatiale et dis moi laquelle est la plus proche.
    _textColor: {r: 0.3207547, g: 0.11949685, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: Hmmm...
    _textColor: {r: 1, g: 0.36585364, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Visiblement, c'est Astrae.
    _textColor: {r: 1, g: 0.36585364, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Alors cap sur Astrae!
    _textColor: {r: 0.3301887, g: 0.12042176, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Serre \xE0 droite."
    _textColor: {r: 0.4339623, g: 0.1582686, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Euh... Tu es s\xFBr que c'est le bon chemin?"
    _textColor: {r: 1, g: 0.36585364, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 4
  - _text: Je crois... Enfin bref, on verra bien!
    _textColor: {r: 0.3773585, g: 0.13762486, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 5
  - _text: ' '
    _textColor: {r: 0.3773585, g: 0.13762486, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 5
  _text: {fileID: 1672512379}
  _index: -1
  _imobilisePlayer: 1
  _controller: {fileID: 0}
  _canActivateSomething: 1
  _objectToActivate: {fileID: 0}
