    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: _textColors.Array.size
      value: 36
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[1]'
      value: "Je vais te faire la liste de toutes les plan\xE8te du syst\xE8me solaire."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[2]'
      value: "De la plus \xE9loign\xE9e \xE0 la plus proche du soleil."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[3]'
      value: "La plus lointaine est Kairos, la plan\xE8te d\xE9potoire."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[4]'
      value: "On l'appelle comme \xE7a parce que la plupart des d\xE9chets se retrouvent
        l\xE0-bas."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[5]'
      value: "Ici, c'est Igara, la deuxi\xE8me plan\xE8te la plus \xE9loign\xE9e
        du soleil."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[6]'
      value: "Ensuite, on a Kepler B, la plan\xE8te de glace."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[7]'
      value: Apparemment, des restes de civilisations disparues se trouveraient sous
        la glace...
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[8]'
      value: "Apr\xE8s, on a Estelion."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[9]'
      value: "La plan\xE8te est coup\xE9e en deux, une partie est toujours expos\xE9e
        au soleil, sur l'autre il fait toujours nuit."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[10]'
      value: "Puis, Gorgon, la plan\xE8te de lave."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[11]'
      value: "C'est l\xE0-bas que se trouve la prison internationale."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[12]'
      value: "Ensuite, on a Garas, la plan\xE8te mar\xE9cageuse."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[13]'
      value: "Il parait qu'il y a des lacs d'acide l\xE0-bas."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[14]'
      value: "Ma plan\xE8te d'origine, Dokan, la plan\xE8te d\xE9sertique."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[15]'
      value: Notamment connue pour ses pyramides.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[16]'
      value: "Et on arrive \xE0 la moiti\xE9 avec Myc\xE9lia, la plan\xE8te champignon."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[17]'
      value: "C'est la plan\xE8te d'origine des myc\xE9liens..."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[18]'
      value: "Les deux parties du syst\xE8me solaire sont s\xE9par\xE9es par l'ISS."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[19]'
      value: "Et on commence la deuxi\xE8me moiti\xE9 avec Zadana, la plan\xE8te
        jungle."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[20]'
      value: "A ce qu'il parait, il y aurait une cit\xE9 faite d'or dans la jungle."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[21]'
      value: "Apr\xE8s \xE7a, on a Mechatris, la plan\xE8te industrielle."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[22]'
      value: "Elle est quasi uniquement peupl\xE9e de robots."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[23]'
      value: "Ma plan\xE8te pr\xE9f\xE9r\xE9e, Zepton, plan\xE8te aquatique."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[24]'
      value: "La plan\xE8te est compos\xE9e d'un oc\xE9an g\xE9ant. Il parait qu'une
        esp\xE8ce aquatique vit l\xE0-bas."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[25]'
      value: "La premi\xE8re plan\xE8te \xE0 avoir \xE9t\xE9 explor\xE9e, Jaker."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[26]'
      value: "C'est la plan\xE8te sur laquelle s'est \xE9cras\xE9e la fus\xE9e amenant
        les humains dans ce syst\xE8me solaire."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[27]'
      value: "Ensuite, on a New Genis, la plan\xE8te luxueuse."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[28]'
      value: Il y a un zoo et un parc d'attraction! J'aimerais trop y aller!
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[29]'
      value: "Reli\xE9e \xE0 New Genis par la Grande Fus\xE9e, nous avons ensuite
        Synkron."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[30]'
      value: "Il parait que c'est une plan\xE8te miroir, invisible tant qu'on n'est
        pas pos\xE9 dessus."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[31]'
      value: "Et pour terminer, la plan\xE8te la plus proche du Soleil..."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[32]'
      value: "H\xE9liopolis, la plan\xE8te royale!"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[33]'
      value: "Apr\xE8s \xE7a, on a la station solaire, mais c'est pas une plan\xE8te,
        alors..."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[34]'
      value: "Merci de m'avoir aid\xE9 \xE0 r\xE9viser!"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[35]'
      value: "J'ai redoubl\xE9 13 fois, alors je prends toute l'aide possible!"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: _otherDialogues.Array.size
      value: 2
      objectReference: {fileID: 0}
