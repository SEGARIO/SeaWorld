--- !u!114 &746598111
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 746598109}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ef99e79683bc6a74ebbe44f3a005ae0c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  entries:
  - _text: ' '
    _textColor: {r: 0, g: 0, b: 0, a: 0}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Aaaaahh! Quel soleil!
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Je suis enfin arriv\xE9 \xE0 Igara! Woohoo!"
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Bon, maintenant, je dois trouver un moyen d'atteindre la prochaine plan\xE8te!"
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  entriesEnglish:
  - _text: ' '
    _textColor: {r: 0, g: 0, b: 0, a: 0}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Aaaaahh! What a sunny day!
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: I finally arrived in Igara! Woohoo!
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: And now... I have to find a way to leave this planet, hehe!
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  _text: {fileID: 1358616519}
  _index: -1
  _imobilisePlayer: 0
  _controller: {fileID: 0}
  _canActivateSomething: 0
  _objectToActivate: {fileID: 0}
