--- !u!114 &1134400299
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1134400298}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ef99e79683bc6a74ebbe44f3a005ae0c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  entries:
  - _text: 
    _textColor: {r: 1, g: 0.3686279, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: Hmmm?
    _textColor: {r: 1, g: 0.36862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Ouaaaah! J'ai bien dormi!
    _textColor: {r: 1, g: 0.36862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Est ce qu'on est arriv\xE9s \xE0 Igara?"
    _textColor: {r: 1, g: 0.36862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Hmmm... On dirait que non. Le train spatial est encore en marche.
    _textColor: {r: 1, g: 0.36862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Pah! J'ai la bouche toute s\xE8che!"
    _textColor: {r: 1, g: 0.36862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Je devrais aller au wagon-bar me prendre un M\xE9gadrink!"
    _textColor: {r: 1, g: 0.36862746, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  _text: {fileID: 1672512379}
  _index: -1
  _imobilisePlayer: 1
  _controller: {fileID: 0}
  _canActivateSomething: 1
  _objectToActivate: {fileID: 0}
