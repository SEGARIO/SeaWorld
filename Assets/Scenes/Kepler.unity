--- !u!114 &980791663
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 980791661}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ef99e79683bc6a74ebbe44f3a005ae0c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  entries:
  - _text: ' '
    _textColor: {r: 0, g: 0, b: 0, a: 0}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 1
  - _text: "Bon, j'accepte de te suivre, mais dans tous les cas, tu n'iras pas tr\xE8s
      loin sans moi."
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Parle pour toi...
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "On va tomber sur une porte ferm\xE9e. "
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Le circuit \xE9lectrique qui permet de l'ouvrir est cass\xE9."
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Ca veut dire qu'elle a besoin d'une impulsion \xE9lectrique externe."
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Ce qui veut dire..?
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Ce qui veut dire que je te pr\xEAte mes balles \xE9lectriques."
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Ce qui veut dire que je te pr\xEAte mes balles \xE9lectriques."
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  entriesEnglish:
  - _text: ' '
    _textColor: {r: 0, g: 0, b: 0, a: 0}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 1
  - _text: "Alright, I\u2019ll go with you, but either way, you won\u2019t get very
      far without me."
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Talk for yourself...
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "We\u2019re going to come across a locked door."
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: The electrical circuit that opens it is broken.
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: That means it needs an extern electric impulse.
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: And that means...?
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Ce qui veut dire que je te pr\xEAte mes balles \xE9lectriques."
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Which means I\u2019ll lend you my electric bullets."
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  _text: {fileID: 1358616519}
  _index: -1
  _imobilisePlayer: 0
  _controller: {fileID: 0}
  _canActivateSomething: 0
  _objectToActivate: {fileID: 0}
