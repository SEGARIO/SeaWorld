      propertyPath: _dialogues.Array.size
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: _textColors.Array.size
      value: 11
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[1]'
      value: "Vous savez que c'est tr\xE8s impoli de d\xE9truire la porte des gens
        quand ils sont aux toilettes?"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[2]'
      value: "D\xE9sol\xE9e, je pensais que c'\xE9tait mon fils..."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[3]'
      value: "Il doit \xEAtre dans les toilettes d'en face alors..."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[4]'
      value: ' '
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[5]'
      value: Maman! J'avais pas fini!
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[6]'
      value: "Oups! Il \xE9tait l\xE0 depuis le d\xE9but! Ha! Ha!"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[7]'
      value: "D\xE9sol\xE9e du d\xE9rangement!"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[8]'
      value: Euh... C'est pas grave...
      objectReference: {fileID: 0}
