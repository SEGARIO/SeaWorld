    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_otherDialogues.Array.data[1]'
      value: "Quand nos anc\xEAtres sont arriv\xE9s sur Igara..."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_otherDialogues.Array.data[2]'
      value: "Ils se sont empress\xE9s de b\xE2tir cette ville."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_otherDialogues.Array.data[3]'
      value: "A l'\xE9poque ils l'avaient baptis\xE9 \"Rocheville\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_otherDialogues.Array.data[4]'
      value: "Mais ils se sont rendus compte bien vite que ce nom \xE9tait pourri."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_otherDialogues.Array.data[5]'
      value: "Alors ils l'ont rebaptis\xE9 \"Rock City\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_otherDialogues.Array.data[6]'
      value: "Mais c'\xE9tait pas forc\xE9ment mieux."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_otherDialogues.Array.data[7]'
      value: 'Des centaines de '
      objectReference: {fileID: 0}
