--- !u!114 &1188703611
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1188703609}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ef99e79683bc6a74ebbe44f3a005ae0c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  entries:
  - _text: ' '
    _textColor: {r: 0, g: 0, b: 0, a: 0}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 1
  - _text: "H\xE9\xE9\xE9\xE9\xE9... Il est gros celui-l\xE0..."
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: C'est vrai qu'il fait peur...
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Mais il est pas plus fort que moi! Ha! Ha!
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Tu vas voiiiir!
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  entriesEnglish:
  - _text: ' '
    _textColor: {r: 0, g: 0, b: 0, a: 0}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 1
  - _text: Heyyyy... This one is big!
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: You're right, it's scary...
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: But I'm stronger than him! Ha! Ha!
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: You will see!
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  _text: {fileID: 1358616519}
  _index: -1
  _imobilisePlayer: 0
  _controller: {fileID: 0}
  _canActivateSomething: 0
  _objectToActivate: {fileID: 0}
