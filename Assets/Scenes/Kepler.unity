--- !u!114 &753825434
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 753825432}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ef99e79683bc6a74ebbe44f3a005ae0c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  entries:
  - _text: ' '
    _textColor: {r: 0, g: 0, b: 0, a: 0}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 1
  - _text: "H\xE9! C'est mon vaisseau, l\xE0-bas!"
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: ' '
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: "Bats le L\xE9vierthan et r\xE9cup\xE9rons-le!"
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Ok! C'est parti!
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: ' '
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 10
  - _text: On dirait que sa carapace est trop dure...
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: "Mais il doit forc\xE9ment avoir un point faible..."
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  entriesEnglish:
  - _text: ' '
    _textColor: {r: 0, g: 0, b: 0, a: 0}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 1
  - _text: Hey! That's my spaceship right there!
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: ' '
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Fight the Leworthan and let's tae my ship back!
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: Okayyyy, let's go!
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 2
  - _text: ' '
    _textColor: {r: 0.654902, g: 0.31764707, b: 1, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 10
  - _text: It's seems like its skinis to thick to even hurt it!
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  - _text: But it has to have a weak spot...
    _textColor: {r: 1, g: 0.49019608, b: 0, a: 1}
    _characterSprite: {fileID: 0}
    _voice: {fileID: 0}
    _time: 3
  _text: {fileID: 1358616519}
  _index: -1
  _imobilisePlayer: 0
  _controller: {fileID: 0}
  _canActivateSomething: 0
  _objectToActivate: {fileID: 0}
