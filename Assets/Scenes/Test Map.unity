    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[1]'
      value: Qu'est ce que tu veux?
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[2]'
      value: Hein? T'es qui, toi?
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[3]'
      value: Je m'appelle Wolf.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[4]'
      value: "Moi, c'est Cosmo! Enchant\xE9!"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[5]'
      value: Super. Maintenant laisse moi tranquille.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[6]'
      value: "J'ai des choses \xE0 faire..."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[7]'
      value: "Moi aussi! Je cherche quelqu'un qui pourrait me faire partir de cette
        plan\xE8te."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[8]'
      value: On m'a dit qu'un pilote se trouvait dans ces grottes.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[9]'
      value: Je suis pilote.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[10]'
      value: Mais tu tombes mal, j'ai perdu mon vaisseau.
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[11]'
      value: Comment tu as pu perdre ton vaisseau?
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[12]'
      value: "Ca fait genre 100 kg ces trucs l\xE0!"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[13]'
      value: "Peut-\xEAtre m\xEAme plus..."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[14]'
      value: "On me l'a vol\xE9."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[15]'
      value: Quoi? Mais qui a bien pu faire une chose pareil?!
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[16]'
      value: "Le L\xE9vierthan."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[17]'
      value: "Le L\xE9vierthan?"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[18]'
      value: "Oui, un ver g\xE9ant qui habite dans ces grottes."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[19]'
      value: "Ok! On va aller le r\xE9cup\xE9rer ton vaisseau!"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[20]'
      value: 'Qu''est ce que tu racontes? '
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[21]'
      value: "Qu'est ce que tu n'as pas compris dans \"ver g\xE9ant\"?"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[22]'
      value: "Si je t'aide \xE0 battre le L\xE9vierthan, est ce que tu m'aideras
        \xE0 partir d'ici?"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[23]'
      value: "Peuh! Si tu arrives \xE0 le battre, non seulement je t'aide..."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[24]'
      value: "Mais en plus je te paye \xE0 manger pendant 1 mois!"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[25]'
      value: "March\xE9 conclu! Allons-y!"
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[26]'
      value: "Tu m'as l'air un peu trop s\xFBr de toi..."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: '_dialogues.Array.data[27]'
      value: "Ca m'inqui\xE8te..."
      objectReference: {fileID: 0}
    - target: {fileID: 2067207842976549832, guid: 2fd1bc5000aaa9a4a9db607666e85755, type: 3}
      propertyPath: _otherDialogues.Array.size
      value: 8
      objectReference: {fileID: 0}
